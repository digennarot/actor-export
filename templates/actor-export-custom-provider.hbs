<section class="standard-form scrollable">
    <div>The custom Javascript Module must export a mapper object of type baseProvider</div>
    <div>imports must have a correct and full URI</div>
    <div>Example:</div>
    <div class="code javascript">
        <pre>
{{ exampleCode }}
        </pre>
    </div>
    <div class="form-group">
        <div class="form-fields">
            <textarea name="actor-export-custom-provider" id="actor-export-custom-provider-javascript" style="color: var(--color-text-dark-input)">{{ customProvider }}</textarea>
        </div>
    </div>
    <div class="form-footer buttons">
        <button type="submit">
            <i class="fa-regular fa-save"></i> Save Changes
        </button>
        <button type="reset">
            <i class="fa-solid fa-undo"></i> Undo
        </button>
    </div>
</section>